#version 430 core
layout(local_size_x=16,local_size_y=16) in;
layout(rg32f,binding=0) readonly uniform image2D stateIn;
layout(rg32f,binding=1) writeonly uniform image2D stateOut;
uniform float dt;

void main() {
    ivec2 size=imageSize(stateIn);
    ivec2 cell=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(cell,size))) return;

    ivec2 left=ivec2(max(cell.x-1,0),cell.y);
    ivec2 right=ivec2(min(cell.x+1,size.x-1),cell.y);
    ivec2 down=ivec2(cell.x,max(cell.y-1,0));
    ivec2 up=ivec2(cell.x,min(cell.y+1,size.y-1));
    vec2 state=imageLoad(stateIn,cell).rg;
    float neighborHeight=imageLoad(stateIn,left).r+imageLoad(stateIn,right).r
        +imageLoad(stateIn,down).r+imageLoad(stateIn,up).r;
    const float cellSize=2000.0/255.0;
    const float waveSpeed=75.0;
    const float damping=0.55;
    float laplacian=(neighborHeight-4.0*state.x)/(cellSize*cellSize);
    state.y+=waveSpeed*waveSpeed*laplacian*dt;
    state.y*=exp(-damping*dt);
    state.x+=state.y*dt;
    imageStore(stateOut,cell,vec4(state,0.0,0.0));
}
