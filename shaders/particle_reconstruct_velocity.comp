#version 430 core
layout(local_size_x = 128) in;
struct Particle { vec4 positionAge; vec4 velocityLife; vec4 data; };
layout(std430,binding=0) buffer Particles { Particle particles[]; };
layout(std430,binding=1) buffer Previous { vec4 previous[]; };
uniform uint capacity;
uniform float dt;

void main() {
    uint id=gl_GlobalInvocationID.x;
    if(id>=capacity || particles[id].data.w<0.5) return;
    previous[id]=vec4((uint(particles[id].data.z)&(32u|64u))!=0u?particles[id].velocityLife.xyz:
        (particles[id].positionAge.xyz-previous[id].xyz)/dt,0);
}
