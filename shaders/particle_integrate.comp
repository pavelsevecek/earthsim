#version 430 core
layout(local_size_x = 128) in;
struct Particle { vec4 positionAge; vec4 velocityLife; vec4 data; };
layout(std430,binding=0) buffer Particles { Particle particles[]; };
layout(std430,binding=1) buffer Previous { vec4 previous[]; };
uniform sampler2D terrainHeight;
uniform uint capacity;
uniform float dt;
uniform float particleLifetime;
uniform float waterLevel;
uniform float windSpeed;
uniform vec2 windDirection;
uniform int tornadoCount;
uniform vec4 tornadoCenterId[8];
uniform vec4 tornadoMovementHeight[8];

float heightAt(vec2 xz) { return texture(terrainHeight,xz/2000.0+0.5).r; }
vec3 terrainNormal(vec2 xz) {
    const float s=2000.0/512.0;
    return normalize(vec3(heightAt(xz-vec2(s,0))-heightAt(xz+vec2(s,0)),2.0*s,heightAt(xz-vec2(0,s))-heightAt(xz+vec2(0,s))));
}
void projectTerrain(inout vec3 p,float radius) {
    if(any(greaterThan(abs(p.xz),vec2(999.0)))) return;
    vec3 n=terrainNormal(p.xz); float ground=heightAt(p.xz);
    float separation=(p.y-ground)*n.y;
    if(separation<radius) { p+=n*(radius-separation); p.y=max(p.y,heightAt(p.xz)+radius/n.y); }
}
void main() {
    uint id=gl_GlobalInvocationID.x;
    if(id>=capacity || particles[id].data.w<0.5) return;
    particles[id].positionAge.w+=dt;
    uint flags=uint(particles[id].data.z);
    float life=(flags&(8u|64u))!=0u?particles[id].velocityLife.w:particleLifetime;
    if(any(greaterThan(abs(particles[id].positionAge.xz),vec2(999.0)))) { particles[id].data.w=0; return; }
    if(particles[id].positionAge.w>=life) {
        bool lava=(flags&1u)!=0u&&(flags&(8u|16u|32u|64u))==0u;
        if(lava)
            particles[id].data.z=768.0;
        else if((flags&16u)!=0u)
            particles[id].data.z=256.0;
        else
            particles[id].data.w=0;
        return;
    }
    previous[id]=vec4(particles[id].positionAge.xyz,0);
    if((flags&64u)!=0u) {
        int tornado=-1;
        for(int i=0;i<tornadoCount;++i)
            if(abs(particles[id].data.y-tornadoCenterId[i].w)<0.25) { tornado=i; break; }
        if(tornado<0) { particles[id].data.w=0.0; return; }
        vec3 oldCenter=tornadoCenterId[tornado].xyz-tornadoMovementHeight[tornado].xyz;
        vec3 relative=particles[id].positionAge.xyz-oldCenter;
        float turn=1.8*dt;
        relative.xz=mat2(cos(turn),-sin(turn),sin(turn),cos(turn))*relative.xz;
        particles[id].positionAge.xyz=tornadoCenterId[tornado].xyz+relative;
        return;
    }
    particles[id].data.y=300.0+(particles[id].data.y-300.0)*exp(-dt/(50.0*particles[id].data.x/1.7));
    for(int i=0;i<tornadoCount;++i) {
        vec3 relative=particles[id].positionAge.xyz-tornadoCenterId[i].xyz;
        float funnelHeight=tornadoMovementHeight[i].w;
        float influenceRadius=10.0+clamp(relative.y,0.0,funnelHeight)*0.2;
        if(relative.y>=-4.0 && relative.y<funnelHeight && length(relative.xz)<influenceRadius &&
            (flags&(1u|16u))!=0u && (flags&(8u|32u))==0u) {
            float radius=max(length(relative.xz),1.0);
            vec2 radial=relative.xz/radius;
            vec2 tangent=vec2(radial.y,-radial.x);
            vec3 targetVelocity=vec3(tornadoMovementHeight[i].x/dt,0.0,tornadoMovementHeight[i].z/dt);
            targetVelocity.xz+=tangent*(32.0+0.18*relative.y)-radial*8.0;
            targetVelocity.y=22.0;
            particles[id].velocityLife.xyz=mix(particles[id].velocityLife.xyz,targetVelocity,1.0-exp(-8.0*dt));
            break;
        }
    }
    if((flags&8u)!=0u) {
        vec2 windVelocity=windDirection*windSpeed;
        particles[id].velocityLife.xz=mix(particles[id].velocityLife.xz,
            windVelocity,1.0-exp(-0.8*dt));
    } else if((flags&32u)!=0u) {
        if((flags&128u)==0u)
            particles[id].velocityLife.y=6.0;
        else {
            particles[id].velocityLife.y+=1.5*dt;
            particles[id].velocityLife.xyz*=exp(-0.18*dt);
        }
        float windStrength=smoothstep(20.0,260.0,particles[id].positionAge.y);
        vec2 crossWind=vec2(-windDirection.y,windDirection.x);
        float variation=0.3*(sin(particles[id].positionAge.z*0.012)
            +cos(particles[id].positionAge.x*0.01));
        vec2 localWindDirection=normalize(windDirection+crossWind*variation);
        particles[id].velocityLife.xz+=localWindDirection
            *(2.4*(windSpeed/10.0)*windStrength*dt);
        particles[id].velocityLife.xz*=exp(-0.12*dt);
    } else if((flags&1u)!=0u) particles[id].velocityLife.y-=12.0*dt;
    particles[id].positionAge.xyz+=particles[id].velocityLife.xyz*dt;
    if((flags&4u)!=0u) projectTerrain(particles[id].positionAge.xyz,max(0.65,particles[id].data.x*0.52));
    if(particles[id].positionAge.y<=waterLevel) {
        if((flags&16u)!=0u) {
            // Pass 8 deposits the carried sediment before retiring the water particle.
            particles[id].data.z=256.0;
            return;
        }
        bool lava=(flags&1u)!=0u&&(flags&(8u|32u))==0u;
        if(lava) {
            // Preserve a pending solid deposit while converting the particle to vapor.
            particles[id].data.z=800.0;
            particles[id].data.y=300.0;
            particles[id].positionAge.w=0.0;
            particles[id].velocityLife.xyz=vec3(0.0,6.0,0.0);
        }
    }
}
