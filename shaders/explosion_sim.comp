#version 430 core
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(rgba16f,binding=0) uniform image3D velocityImage;
layout(r16f,binding=1) uniform image3D smokeImage;
layout(r16f,binding=2) uniform image3D temperatureImage;
layout(r16f,binding=3) uniform image3D scalarImage;
uniform sampler3D velocityTexture;
uniform sampler3D smokeTexture;
uniform sampler3D temperatureTexture;
uniform sampler3D divergenceTexture;
uniform sampler3D pressureTexture;
uniform sampler2D terrainHeight;
uniform ivec3 volumeSize;
uniform int pass;
uniform float dt;
uniform float age;
uniform float strength;
uniform float windSpeed;
uniform vec2 windDirection;
uniform vec3 boxMin;
uniform vec3 boxMax;

vec3 uvFor(ivec3 p) { return (vec3(p)+0.5)/vec3(volumeSize); }
vec3 worldFor(vec3 uv) { return mix(boxMin,boxMax,uv); }
bool outside(vec3 uv) { return any(lessThan(uv,vec3(0.0)))||any(greaterThan(uv,vec3(1.0))); }
vec3 velocityAt(vec3 uv) { return outside(uv)?vec3(0.0):texture(velocityTexture,uv).xyz; }
float pressureAt(vec3 uv) { return outside(uv)?0.0:texture(pressureTexture,uv).r; }
float terrainSurface(vec2 xz) {
    if(any(greaterThan(abs(xz),vec2(1000.0)))) return boxMin.y-1000.0;
    return textureLod(terrainHeight,xz/2000.0+0.5,0.0).r;
}
vec3 curlAt(vec3 uv,vec3 texel) {
    vec3 l=velocityAt(uv-vec3(texel.x,0,0)),r=velocityAt(uv+vec3(texel.x,0,0));
    vec3 d=velocityAt(uv-vec3(0,texel.y,0)),u=velocityAt(uv+vec3(0,texel.y,0));
    vec3 b=velocityAt(uv-vec3(0,0,texel.z)),f=velocityAt(uv+vec3(0,0,texel.z));
    vec3 inv=vec3(volumeSize)/(boxMax-boxMin);
    return 0.5*vec3((u.z-d.z)*inv.y-(f.y-b.y)*inv.z,
        (f.x-b.x)*inv.z-(r.z-l.z)*inv.x,
        (r.y-l.y)*inv.x-(u.x-d.x)*inv.y);
}

void main() {
    ivec3 p=ivec3(gl_GlobalInvocationID.xyz);
    if(any(greaterThanEqual(p,volumeSize))) return;
    vec3 uv=uvFor(p),world=worldFor(uv),extent=boxMax-boxMin;
    vec3 texel=1.0/vec3(volumeSize);
    vec3 center=vec3((boxMin.x+boxMax.x)*0.5,boxMin.y+38.0*strength,
        (boxMin.z+boxMax.z)*0.5);
    float ground=terrainSurface(world.xz);
    if(pass==0) {
        vec3 relative=world-center;
        float r=length(vec3(relative.x/(48.0*strength),
            relative.y/(30.0*strength),relative.z/(48.0*strength)));
        float core=1.0-smoothstep(0.25,1.0,r);
        float shell=1.0-smoothstep(0.55,1.35,r);
        vec3 radial=relative;
        float horizontalLength=length(radial.xz);
        vec2 outward=horizontalLength>0.01?radial.xz/horizontalLength:vec2(0.0);
        // Expand the fireball broadly without adding its radial Y component to
        // the central lift. Previously those two impulses stacked into a jet.
        vec3 velocity=vec3(outward.x*38.0*strength*core,
            38.0*strength*core,outward.y*38.0*strength*core);
        if(world.y<=ground) { core=0.0; shell=0.0; velocity=vec3(0.0); }
        imageStore(velocityImage,p,vec4(velocity,0.0));
        imageStore(smokeImage,p,vec4(shell*0.82));
        imageStore(temperatureImage,p,vec4(core));
        imageStore(scalarImage,p,vec4(0.0));
        return;
    }
    if(pass==1) {
        vec3 oldVelocity=texture(velocityTexture,uv).xyz;
        vec3 previousUv=uv-oldVelocity*dt/extent;
        vec3 velocity=velocityAt(previousUv);
        float smoke=outside(previousUv)?0.0:texture(smokeTexture,previousUv).r;
        float temperature=outside(previousUv)?0.0:texture(temperatureTexture,previousUv).r;
        float altitude=clamp((world.y-boxMin.y)/extent.y,0.0,1.0);
        vec3 targetWind=vec3(windDirection.x,0.0,windDirection.y)*windSpeed*(0.2+0.8*altitude);
        velocity.xz=mix(velocity.xz,targetWind.xz,1.0-exp(-0.22*dt));
        float neutralHeight=boxMin.y+0.48*extent.y;
        float neutralApproach=smoothstep(neutralHeight-85.0*strength,
            neutralHeight+35.0*strength,world.y);
        float overshoot=max(world.y-neutralHeight,0.0)/strength;
        // A stably stratified atmosphere arrests the thermal near its neutral
        // buoyancy altitude. Pressure projection then redirects the remaining
        // momentum sideways instead of letting the plume remain a chimney.
        float buoyantMaterial=max(smoke,temperature);
        float stratification=(46.0+0.28*overshoot)*buoyantMaterial*neutralApproach;
        velocity.y+=(36.0*temperature-5.0*smoke-stratification)*dt;
        velocity.y*=exp(-1.4*neutralApproach*dt);
        vec2 fromCenter=world.xz-center.xz;
        float radialDistance=length(fromCenter);
        vec2 radialDirection=radialDistance>0.01?fromCenter/radialDistance:vec2(0.0);
        float capBand=exp(-pow((world.y-neutralHeight)/(55.0*strength),2.0));
        float capInterior=1.0-smoothstep(130.0*strength,175.0*strength,radialDistance);
        velocity.xz+=radialDirection*(30.0*strength*buoyantMaterial*capBand*capInterior*dt);
        float stem=exp(-dot(fromCenter,fromCenter)/(380.0*strength*strength))
            *exp(-max(world.y-center.y,0.0)/(70.0*strength))*exp(-age/1.1);
        velocity.y+=7.0*strength*stem*dt;
        velocity*=exp(-0.025*dt);
        if(world.y<=ground+2.0 || p.y==0 || p.y==volumeSize.y-1) velocity.y=max(velocity.y,0.0);
        if(p.x==0||p.x==volumeSize.x-1) velocity.x=0.0;
        if(p.z==0||p.z==volumeSize.z-1) velocity.z=0.0;
        imageStore(velocityImage,p,vec4(clamp(velocity,vec3(-300.0),vec3(300.0)),0.0));
    } else if(pass==2) {
        vec3 l=velocityAt(uv-vec3(texel.x,0,0)),r=velocityAt(uv+vec3(texel.x,0,0));
        vec3 d=velocityAt(uv-vec3(0,texel.y,0)),u=velocityAt(uv+vec3(0,texel.y,0));
        vec3 b=velocityAt(uv-vec3(0,0,texel.z)),f=velocityAt(uv+vec3(0,0,texel.z));
        vec3 inv=vec3(volumeSize)/extent;
        float divergence=0.5*((r.x-l.x)*inv.x+(u.y-d.y)*inv.y+(f.z-b.z)*inv.z);
        imageStore(scalarImage,p,vec4(divergence));
    } else if(pass==3) {
        float l=pressureAt(uv-vec3(texel.x,0,0)),r=pressureAt(uv+vec3(texel.x,0,0));
        float d=pressureAt(uv-vec3(0,texel.y,0)),u=pressureAt(uv+vec3(0,texel.y,0));
        float b=pressureAt(uv-vec3(0,0,texel.z)),f=pressureAt(uv+vec3(0,0,texel.z));
        float divergence=texture(divergenceTexture,uv).r;
        imageStore(scalarImage,p,vec4((l+r+d+u+b+f-divergence*0.45)/6.0));
    } else if(pass==4) {
        float l=pressureAt(uv-vec3(texel.x,0,0)),r=pressureAt(uv+vec3(texel.x,0,0));
        float d=pressureAt(uv-vec3(0,texel.y,0)),u=pressureAt(uv+vec3(0,texel.y,0));
        float b=pressureAt(uv-vec3(0,0,texel.z)),f=pressureAt(uv+vec3(0,0,texel.z));
        vec3 inv=vec3(volumeSize)/extent;
        vec3 velocity=texture(velocityTexture,uv).xyz
            -0.5*vec3(r-l,u-d,f-b)*inv;
        vec3 curl=curlAt(uv,texel);
        float curlL=length(curlAt(uv-vec3(texel.x,0,0),texel));
        float curlR=length(curlAt(uv+vec3(texel.x,0,0),texel));
        float curlD=length(curlAt(uv-vec3(0,texel.y,0),texel));
        float curlU=length(curlAt(uv+vec3(0,texel.y,0),texel));
        float curlB=length(curlAt(uv-vec3(0,0,texel.z),texel));
        float curlF=length(curlAt(uv+vec3(0,0,texel.z),texel));
        vec3 gradient=0.5*vec3(curlR-curlL,curlU-curlD,curlF-curlB)*inv;
        if(length(gradient)>0.0001)
            velocity+=cross(normalize(gradient),curl)*(10.0*dt);
        // Projection removes divergent motion, so restore the atmospheric
        // pressure-driven outflow at the neutral layer after projection.
        float neutralHeight=boxMin.y+0.48*extent.y;
        vec2 fromCenter=world.xz-center.xz;
        float radialDistance=length(fromCenter);
        vec2 radialDirection=radialDistance>0.01?fromCenter/radialDistance:vec2(0.0);
        float capBand=exp(-pow((world.y-neutralHeight)/(55.0*strength),2.0));
        float capInterior=1.0-smoothstep(130.0*strength,175.0*strength,radialDistance);
        float smoke=texture(smokeTexture,uv).r;
        velocity.xz+=radialDirection*(18.0*strength*smoke*capBand*capInterior*dt);
        if(world.y<=ground) velocity=vec3(0.0);
        imageStore(velocityImage,p,vec4(clamp(velocity,vec3(-300.0),vec3(300.0)),0.0));
    } else if(pass==5) {
        vec3 velocity=texture(velocityTexture,uv).xyz;
        vec3 previousUv=uv-velocity*dt/extent;
        float smoke=outside(previousUv)?0.0:texture(smokeTexture,previousUv).r;
        float temperature=outside(previousUv)?0.0:texture(temperatureTexture,previousUv).r;
        vec2 radial=world.xz-center.xz;
        float source=exp(-dot(radial,radial)/(420.0*strength*strength))
            *exp(-pow((world.y-(boxMin.y+18.0*strength))/(22.0*strength),2.0))
            *exp(-age/1.25);
        smoke+=source*1.1*dt;
        temperature+=source*1.8*dt;
        smoke*=exp(-0.010*dt);
        // Approximate adiabatic cooling by the parcel's upward displacement.
        // The projected solver is incompressible, so its divergence cannot
        // provide the compressible expansion term directly.
        temperature-=0.0016*max(velocity.y,0.0)*dt;
        temperature*=exp(-0.075*dt);
        if(world.y<=ground) { smoke=0.0; temperature=0.0; }
        imageStore(smokeImage,p,vec4(clamp(smoke,0.0,1.5)));
        imageStore(temperatureImage,p,vec4(clamp(temperature,0.0,1.0)));
    }
}
