#version 430 core
layout(local_size_x=128) in;
struct RainDrop { vec4 positionAge; vec4 velocityState; };
struct Particle { vec4 positionAge; vec4 velocityLife; vec4 data; };
layout(std430,binding=0) buffer RainDrops { RainDrop drops[]; };
layout(std430,binding=1) readonly buffer MainParticles { Particle particles[]; };
layout(std430,binding=2) readonly buffer Heads { int heads[]; };
layout(std430,binding=3) readonly buffer Next { int nextParticle[]; };
layout(std430,binding=4) buffer Wetness { uint wetness[]; };
uniform sampler2D terrainHeight;
uniform sampler3D cloudDensityTexture;
uniform uint capacity;
uniform uint frameSeed;
uniform int pass;
uniform float dt;
uniform float intensity;
uniform float cloudCoverage;
uniform float time;
uniform float waterLevel;
uniform float windSpeed;
uniform float cloudBase;
uniform float cloudTop;
uniform vec3 eye;
const uint wetnessSize=256u;
const uint bucketCount=32768u;
const float support=4.0;
const vec2 windDirection=normalize(vec2(0.85,0.35));

uint hash(uint x) {
    x^=x>>16u; x*=0x7feb352du; x^=x>>15u; x*=0x846ca68bu; return x^(x>>16u);
}
float random(uint seed) { return float(hash(seed)>>8u)*(1.0/16777216.0); }
ivec3 particleCell(vec3 p) { return ivec3(floor(p/support)); }
uint hashCell(ivec3 c) {
    return (uint(c.x)*73856093u^uint(c.y)*19349663u^uint(c.z)*83492791u)&(bucketCount-1u);
}
float heightAt(vec2 xz) { return texture(terrainHeight,xz/2000.0+0.5).r; }
float cloudDensity(vec3 p) {
    if(cloudCoverage <= 0.0001) return 0.0;
    float layer=(p.y-cloudBase)/(cloudTop-cloudBase);
    float profile=smoothstep(0.0,0.16,layer)*(1.0-smoothstep(0.48,1.0,layer));
    vec3 volumeUv=(p-vec3(-2200.0,cloudBase,-2200.0))/vec3(4400.0,cloudTop-cloudBase,4400.0);
    float shape=textureLod(cloudDensityTexture,volumeUv,0.0).r;
    float threshold=mix(0.68,0.18,cloudCoverage);
    return smoothstep(threshold,threshold+0.29,shape)*profile;
}
bool touchesLava(vec3 p) {
    ivec3 origin=particleCell(p);
    for(int z=-1;z<=1;++z) for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x) {
        ivec3 cell=origin+ivec3(x,y,z);
        for(int j=heads[hashCell(cell)],guard=0;j>=0&&guard<512;j=nextParticle[j],++guard) {
            if(any(notEqual(particleCell(particles[j].positionAge.xyz),cell))||particles[j].data.w<0.5) continue;
            uint flags=uint(particles[j].data.z);
            bool lava=(flags&1u)!=0u&&(flags&(8u|16u|32u))==0u;
            float radius=particles[j].data.x*0.6+1.0;
            if(lava&&distance(p,particles[j].positionAge.xyz)<radius) return true;
        }
    }
    return false;
}
void main() {
    uint id=gl_GlobalInvocationID.x;
    if(pass==0) {
        if(id<wetnessSize*wetnessSize)
            wetness[id]=uint(float(wetness[id])*exp(-dt/45.0));
        return;
    }
    if(id>=capacity) return;
    int state=int(drops[id].velocityState.w+0.5);
    if(state==0) {
        uint seed=hash(id^frameSeed*747796405u);
        if(random(seed)>1.0-exp(-0.18*intensity*dt)) return;
        vec3 p=vec3(eye.x+(random(seed+1u)*2.0-1.0)*900.0,
            cloudBase+(0.17+random(seed+2u)*0.81)*(cloudTop-cloudBase),
            eye.z+(random(seed+3u)*2.0-1.0)*900.0);
        if(any(greaterThan(abs(p.xz),vec2(990.0)))||cloudDensity(p)<0.12) return;
        drops[id].positionAge=vec4(p,0.0);
        drops[id].velocityState=vec4(windDirection*(windSpeed/10.0)*mix(2.0,7.0,random(seed+4u)),
            -mix(55.0,75.0,random(seed+5u)),1.0);
        return;
    }
    drops[id].positionAge.w+=dt;
    if(state==1) {
        drops[id].velocityState.y=max(-90.0,drops[id].velocityState.y-18.0*dt);
        drops[id].velocityState.xz=mix(drops[id].velocityState.xz,windDirection*(windSpeed/10.0)*12.0,1.0-exp(-0.5*dt));
        drops[id].positionAge.xyz+=drops[id].velocityState.xyz*dt;
        vec3 p=drops[id].positionAge.xyz;
        float ground=heightAt(p.xz),surface=max(ground,waterLevel);
        if(p.y<=surface) {
            p.y=surface; drops[id].positionAge.xyz=p;
            if(waterLevel>ground+0.05) {
                drops[id].positionAge.w=0.0; drops[id].velocityState=vec4(0,0,0,3);
            } else if(touchesLava(p)) {
                drops[id].positionAge.w=0.0; drops[id].velocityState=vec4(0,6,0,2);
            } else {
                vec2 uv=clamp(p.xz/2000.0+0.5,vec2(0),vec2(0.99999));
                uvec2 cell=uvec2(uv*float(wetnessSize));
                atomicAdd(wetness[cell.y*wetnessSize+cell.x],6000u);
                drops[id].velocityState.w=0.0;
            }
        } else if(p.y<-150.0||any(greaterThan(abs(p.xz),vec2(1000.0)))) drops[id].velocityState.w=0.0;
    } else if(state==2) {
        float windStrength=smoothstep(20.0,260.0,drops[id].positionAge.y);
        drops[id].velocityState.xyz=vec3(windDirection*(windSpeed/10.0)*8.0*windStrength,6.0);
        drops[id].positionAge.xyz+=drops[id].velocityState.xyz*dt;
        if(drops[id].positionAge.w>=3.0) drops[id].velocityState.w=0.0;
    } else if(state==3) {
        if(drops[id].positionAge.w>=1.0) drops[id].velocityState.w=0.0;
    }
}
