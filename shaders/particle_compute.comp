#version 430 core
layout(local_size_x = 128) in;
struct Particle { vec4 positionAge; vec4 velocityLife; vec4 data; };
layout(std430,binding=0) buffer Particles { Particle particles[]; };
layout(std430,binding=1) buffer Previous { vec4 previous[]; };
layout(std430,binding=2) buffer Scratch { vec4 scratch[]; };
layout(std430,binding=3) buffer Lambdas { float lambdas[]; };
layout(std430,binding=4) buffer Heads { int heads[]; };
layout(std430,binding=5) buffer Next { int nextParticle[]; };
uniform sampler2D terrainHeight;
uniform int pass;
uniform uint capacity;
uniform float dt;
uniform bool interactions;
uniform float particleLifetime;
uniform float waterLevel;
const float support=4.0;
const float restDensity=1.0/(1.5*1.5*1.5);
const uint bucketCount=32768u;

ivec3 particleCell(vec3 p) { return ivec3(floor(p/support)); }
uint hashCell(ivec3 c) { return (uint(c.x)*73856093u ^ uint(c.y)*19349663u ^ uint(c.z)*83492791u)&(bucketCount-1u); }
float kernel(float r2) { float q=max(0.0,support*support-r2); return 315.0/(64.0*3.14159265*pow(support,9.0))*q*q*q; }
vec3 gradientKernel(vec3 d,float r,uint i,uint j) {
    if(r<0.0001) {
        uint key=min(i,j)*1664525u+max(i,j)*1013904223u;
        d=vec3(0); d[key%3u]=(i<j?1.0:-1.0)*0.0001; r=0.0001;
    }
    return d*(-45.0/(3.14159265*pow(support,6.0))*pow(support-r,2.0)/r);
}
float heightAt(vec2 xz) { return texture(terrainHeight,xz/2000.0+0.5).r; }
vec3 terrainNormal(vec2 xz) {
    const float s=2000.0/512.0;
    return normalize(vec3(heightAt(xz-vec2(s,0))-heightAt(xz+vec2(s,0)),2.0*s,heightAt(xz-vec2(0,s))-heightAt(xz+vec2(0,s))));
}
void projectTerrain(inout vec3 p,float radius) {
    if(any(greaterThan(abs(p.xz),vec2(999.0)))) return;
    vec3 n=terrainNormal(p.xz); float ground=heightAt(p.xz);
    float separation=(p.y-ground)*n.y;
    if(separation<radius) { p+=n*(radius-separation); p.y=max(p.y,heightAt(p.xz)+radius/n.y); }
}
void visitDensity(uint id,out float density,out float gradientSquared,out vec3 gradientSum) {
    density=kernel(0); gradientSquared=0; gradientSum=vec3(0);
    ivec3 origin=particleCell(particles[id].positionAge.xyz);
    for(int z=-1;z<=1;++z) for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x) {
        ivec3 cell=origin+ivec3(x,y,z);
        for(int j=heads[hashCell(cell)],guard=0;j>=0 && guard<512;j=nextParticle[j],++guard) {
            if(uint(j)==id || any(notEqual(particleCell(particles[j].positionAge.xyz),cell))) continue;
            vec3 d=particles[id].positionAge.xyz-particles[j].positionAge.xyz; float r2=dot(d,d);
            if(r2>=support*support) continue;
            density+=kernel(r2); vec3 g=gradientKernel(d,sqrt(r2),id,uint(j))/restDensity;
            gradientSum+=g; gradientSquared+=dot(g,g);
        }
    }
}
void main() {
    uint id=gl_GlobalInvocationID.x;
    if(pass==0) {
        if(id<bucketCount) heads[id]=-1;
        return;
    }
    if(id>=capacity) return;
    if(particles[id].data.w<0.5) return;
    if(pass==1) {
        particles[id].positionAge.w+=dt;
        uint flags=uint(particles[id].data.z);
        float life=(flags&8u)!=0u?particles[id].velocityLife.w:particleLifetime;
        if(particles[id].positionAge.w>=life || any(greaterThan(abs(particles[id].positionAge.xz),vec2(999.0)))) { particles[id].data.w=0; return; }
        particles[id].data.y=300.0+(particles[id].data.y-300.0)*exp(-dt/(50.0*particles[id].data.x/1.7));
        previous[id]=vec4(particles[id].positionAge.xyz,0);
        if((flags&32u)!=0u) {
            particles[id].velocityLife.y=6.0;
            float windStrength=smoothstep(20.0,260.0,particles[id].positionAge.y);
            vec2 windDirection=normalize(vec2(0.85+0.3*sin(particles[id].positionAge.z*0.012),
                0.35+0.3*cos(particles[id].positionAge.x*0.01)));
            particles[id].velocityLife.xz+=windDirection*(2.4*windStrength*dt);
            particles[id].velocityLife.xz*=exp(-0.12*dt);
        } else if((flags&1u)!=0u) particles[id].velocityLife.y-=12.0*dt;
        particles[id].positionAge.xyz+=particles[id].velocityLife.xyz*dt;
        if((flags&4u)!=0u) projectTerrain(particles[id].positionAge.xyz,max(0.65,particles[id].data.x*0.52));
        if(particles[id].positionAge.y<=waterLevel) {
            if((flags&16u)!=0u) {
                // Spring water merges into the flat water body.
                particles[id].data.w=0.0;
                return;
            }
            bool lava=(flags&1u)!=0u&&(flags&(8u|32u))==0u;
            if(lava) {
                particles[id].data.z=32.0;
                particles[id].data.y=300.0;
                particles[id].positionAge.w=0.0;
                particles[id].velocityLife.xyz=vec3(0.0,6.0,0.0);
            }
        }
    } else if(pass==2) {
        if((uint(particles[id].data.z)&2u)==0u) return;
        ivec3 c=particleCell(particles[id].positionAge.xyz); nextParticle[id]=atomicExchange(heads[hashCell(c)],int(id));
    } else if(pass==3) {
        if(!interactions || (uint(particles[id].data.z)&2u)==0u) { lambdas[id]=0; return; }
        float density,g2; vec3 gs; visitDensity(id,density,g2,gs);
        float constraint=max(0.0,density/restDensity-1.0); lambdas[id]=-constraint/(g2+dot(gs,gs)+0.01);
    } else if(pass==4) {
        vec3 correction=vec3(0);
        if(interactions && (uint(particles[id].data.z)&2u)!=0u) {
            ivec3 origin=particleCell(particles[id].positionAge.xyz);
            for(int z=-1;z<=1;++z) for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x) {
                ivec3 cell=origin+ivec3(x,y,z);
                for(int j=heads[hashCell(cell)],guard=0;j>=0 && guard<512;j=nextParticle[j],++guard) {
                    if(uint(j)==id || any(notEqual(particleCell(particles[j].positionAge.xyz),cell))) continue;
                    vec3 d=particles[id].positionAge.xyz-particles[j].positionAge.xyz; float r2=dot(d,d);
                    if(r2>=support*support) continue;
                    float ratio=kernel(r2)/kernel(0.09*support*support);
                    correction+=gradientKernel(d,sqrt(r2),id,uint(j))*(lambdas[id]+lambdas[j]-0.001*pow(ratio,4.0))/restDensity;
                }
            }
        }
        float lengthCorrection=length(correction); scratch[id]=vec4(correction*(lengthCorrection>0.6?0.6/lengthCorrection:1.0),0);
    } else if(pass==5) {
        particles[id].positionAge.xyz+=scratch[id].xyz;
        if((uint(particles[id].data.z)&4u)!=0u) projectTerrain(particles[id].positionAge.xyz,max(0.65,particles[id].data.x*0.52));
    } else if(pass==6) {
        previous[id]=vec4((uint(particles[id].data.z)&32u)!=0u?particles[id].velocityLife.xyz:
            (particles[id].positionAge.xyz-previous[id].xyz)/dt,0);
    } else if(pass==7) {
        vec3 velocity=previous[id].xyz;
        if(interactions && (uint(particles[id].data.z)&2u)!=0u) {
            vec3 average=vec3(0); float weights=0; ivec3 origin=particleCell(particles[id].positionAge.xyz);
            for(int z=-1;z<=1;++z) for(int y=-1;y<=1;++y) for(int x=-1;x<=1;++x) {
                ivec3 cell=origin+ivec3(x,y,z);
                for(int j=heads[hashCell(cell)],guard=0;j>=0 && guard<512;j=nextParticle[j],++guard) {
                    if(uint(j)==id || any(notEqual(particleCell(particles[j].positionAge.xyz),cell))) continue;
                    vec3 d=particles[id].positionAge.xyz-particles[j].positionAge.xyz; float r2=dot(d,d);
                    if(r2>=support*support) continue;
                    float w=kernel(r2); average+=previous[j].xyz*w; weights+=w;
                }
            }
            if(weights>0) velocity=mix(velocity,average/weights,1.0-exp(-5.0*dt));
        }
        if((uint(particles[id].data.z)&4u)!=0u) {
            vec3 n=terrainNormal(particles[id].positionAge.xz); float radius=max(0.65,particles[id].data.x*0.52);
            if((particles[id].positionAge.y-heightAt(particles[id].positionAge.xz))*n.y<=radius+0.05) {
                float inward=dot(velocity,n); if(inward<0) velocity-=n*(1.01*inward);
                float friction=(uint(particles[id].data.z)&16u)!=0u?0.3:1.5;
                vec3 normalVelocity=n*dot(velocity,n);
                velocity=normalVelocity+(velocity-normalVelocity)*exp(-friction*dt);
            }
        }
        particles[id].velocityLife.xyz=velocity;
    } else if(pass==9) {
        uint flags=uint(particles[id].data.z);
        if((flags&16u)==0u) return;
        bool touchesLava=false;
        ivec3 origin=particleCell(particles[id].positionAge.xyz);
        for(int z=-1;z<=1 && !touchesLava;++z) for(int y=-1;y<=1 && !touchesLava;++y) for(int x=-1;x<=1 && !touchesLava;++x) {
            ivec3 cell=origin+ivec3(x,y,z);
            for(int j=heads[hashCell(cell)],guard=0;j>=0 && guard<512;j=nextParticle[j],++guard) {
                if(uint(j)==id || any(notEqual(particleCell(particles[j].positionAge.xyz),cell))) continue;
                uint otherFlags=uint(particles[j].data.z);
                bool lava=(otherFlags&1u)!=0u && (otherFlags&(8u|16u|32u))==0u;
                if(!lava) continue;
                vec3 delta=particles[id].positionAge.xyz-particles[j].positionAge.xyz;
                float contactRadius=0.5*(particles[id].data.x+particles[j].data.x);
                if(dot(delta,delta)<=contactRadius*contactRadius) { touchesLava=true; break; }
            }
        }
        if(touchesLava) {
            particles[id].data.z=32.0;
            particles[id].data.y=300.0;
            particles[id].positionAge.w=0.0;
            particles[id].velocityLife.xyz=vec3(0.0,6.0,0.0);
        }
    }
}
